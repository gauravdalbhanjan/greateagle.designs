        <mxCell id="v112" value="12" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="1139" y="301" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v113" value="13" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="993" y="623" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v114" value="14" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="1169" y="513" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v115" value="15" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="479" y="831" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v116" value="16" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="1139" y="721" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v117" value="17" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="1089" y="813" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v118" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;fillColor=#FFFFFF;strokeColor=#9EB459;strokeWidth=1.2;dashed=0;fontFamily=Calibri;fontSize=13;fontColor=#4C5211;align=center;verticalAlign=middle;fontStyle=0;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="24" y="888" width="1872" height="150" as="geometry"/></mxCell>
        <mxCell id="v119" value="NUMBERED FLOWS" style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Trebuchet MS;fontSize=12;fontColor=#4C5211;align=left;verticalAlign=middle;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="894" width="300" height="18" as="geometry"/></mxCell>
        <mxCell id="v120" value="1" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="39" y="914" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v121" value="Caller dials the toll-free number; Amazon Connect answers." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Calibri;fontSize=13;fontColor=#4C5211;align=left;verticalAlign=middle;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="916" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="v122" value="2" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="39" y="934" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v123" value="Connect streams speech to Amazon Transcribe; Amazon Lex handles the intent." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Calibri;fontSize=13;fontColor=#4C5211;align=left;verticalAlign=middle;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="936" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="v124" value="3" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="39" y="954" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v125" value="Lex hands the intent to AWS Lambda." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Calibri;fontSize=13;fontColor=#4C5211;align=left;verticalAlign=middle;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="956" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="v126" value="4" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="39" y="974" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v127" value="Lambda asks Amazon Bedrock (Amazon Nova Micro) for the answer." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Calibri;fontSize=13;fontColor=#4C5211;align=left;verticalAlign=middle;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="976" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="v128" value="5" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="39" y="994" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v129" value="Lambda → Amazon Polly → Connect: the caller hears the answer." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Calibri;fontSize=13;fontColor=#4C5211;align=left;verticalAlign=middle;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="996" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="v130" value="6" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="39" y="1014" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v131" value="Echo Show → Alexa Skills Kit → Lambda." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Calibri;fontSize=13;fontColor=#4C5211;align=left;verticalAlign=middle;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="1016" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="v132" value="7" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="585" y="914" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v133" value="Apps → AWS WAF → Amazon CloudFront → AWS Amplify (front end)." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Calibri;fontSize=13;fontColor=#4C5211;align=left;verticalAlign=middle;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="612" y="916" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="v134" value="8" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="585" y="934" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v135" value="Apps → AWS WAF → API Gateway → Lambda; sign-in with Amazon Cognito." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Calibri;fontSize=13;fontColor=#4C5211;align=left;verticalAlign=middle;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="612" y="936" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="v136" value="9" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="585" y="954" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v137" value="Laptop as extension display: laptop → home screen, via the app." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Calibri;fontSize=13;fontColor=#4C5211;align=left;verticalAlign=middle;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="612" y="956" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="v138" value="10" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="585" y="974" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v139" value="AWS IoT Greengrass processes infrared/depth data on the device." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Calibri;fontSize=13;fontColor=#4C5211;align=left;verticalAlign=middle;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="612" y="976" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="v140" value="11" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="585" y="994" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v141" value="Event messages only (presence, fall, hazard) → IoT Core → EventBridge → Lambda." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Calibri;fontSize=13;fontColor=#4C5211;align=left;verticalAlign=middle;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="612" y="996" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="v142" value="12" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="585" y="1014" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v143" value="Lambda ↔ DynamoDB (profiles, consent, sessions) and S3 (content, packs, logs)." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Calibri;fontSize=13;fontColor=#4C5211;align=left;verticalAlign=middle;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="612" y="1016" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="v144" value="13" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="1131" y="914" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v145" value="EventBridge → Amazon SNS → SMS and push alerts to users’ phones." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Calibri;fontSize=13;fontColor=#4C5211;align=left;verticalAlign=middle;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1158" y="916" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="v146" value="14" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="1131" y="934" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v147" value="Lambda → API Gateway → SaaS app catalog." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Calibri;fontSize=13;fontColor=#4C5211;align=left;verticalAlign=middle;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1158" y="936" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="v148" value="15" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="1131" y="954" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v149" value="Emergency: device → phone → cellular network → IoT Core → EventBridge → Lambda." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Calibri;fontSize=13;fontColor=#4C5211;align=left;verticalAlign=middle;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1158" y="956" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="v150" value="16" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="1131" y="974" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v151" value="Lambda → Location Service → IoT Core → phone → device projects exit routes." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Calibri;fontSize=13;fontColor=#4C5211;align=left;verticalAlign=middle;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1158" y="976" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="v152" value="17" style="ellipse;html=0;fillColor=#FF2A00;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="1131" y="994" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v153" value="No phone link: local audio + offline guidance pack on the device." style="text;html=0;strokeColor=none;fillColor=none;fontFamily=Calibri;fontSize=13;fontColor=#4C5211;align=left;verticalAlign=middle;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1158" y="996" width="500" height="18" as="geometry"/></mxCell>
